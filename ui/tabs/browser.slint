import { Theme } from "../theme.slint";
import { Spinner } from "std-widgets.slint";
import { Button } from "g_widgets.slint";
import { SidebarState } from "../menus.slint";
import { PaletteState } from "../palette.slint";
import { PickerDemo } from "../pickers.slint";
import { CompareState } from "../compare.slint";
import { SettingsPageState } from "../settings_page.slint";

// ブラウザタブ(65 第 2 段)。URL 欄の下の領域に、inocode-browser(CEF)の子ウィンドウを Rust が重ねる。
// このファイルと src/tabs/browser.rs。

export global BrowserState {
    in-out property <string> url;
    // 0 起動していない、1 起動中、2 表示中、3 失敗
    in property <int> phase: 0;
    in property <string> error;
    // 子ウィンドウを置く領域(窓の中の論理座標)。BrowserTab が書く。
    in-out property <length> view-x;
    in-out property <length> view-y;
    in-out property <length> view-w;
    in-out property <length> view-h;
    // メニューや画面が上に開いている間は、子ウィンドウを隠す(子ウィンドウは Slint の描画より上に出るため)。
    out property <bool> covered: SidebarState.menu-open || PaletteState.open || PickerDemo.open
        || CompareState.open || SettingsPageState.open;
    callback open();
    callback close();
}

export component BrowserTab inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: Theme.hover;
                ti := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: Theme.fg;
                    selection-foreground-color: Theme.fg;
                    selection-background-color: #4d8ff566;
                    single-line: true;
                    text <=> BrowserState.url;
                    accepted => { BrowserState.open(); }
                }
                TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
            }
            Button { label: "開く"; primary: true; clicked => { BrowserState.open(); } }
            if BrowserState.phase == 2: Button { label: "閉じる"; clicked => { BrowserState.close(); } }
        }
        view := Rectangle {
            vertical-stretch: 1;
            if BrowserState.phase == 1: Spinner { indeterminate: true; width: 24px; height: 24px; }
            if BrowserState.phase == 3: Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: BrowserState.error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
    Timer {
        interval: 33ms;
        running: true;
        triggered => {
            BrowserState.view-x = view.absolute-position.x;
            BrowserState.view-y = view.absolute-position.y;
            BrowserState.view-w = view.width;
            BrowserState.view-h = view.height;
        }
    }
}
