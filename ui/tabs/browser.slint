import { Theme } from "../theme.slint";
import { Spinner } from "std-widgets.slint";
import { Button } from "g_widgets.slint";

// ブラウザタブ(65 第 1 段)。中身は別窓の inocode-browser(CEF)。タブには URL 欄と、起動中のスピナーだけ。
// このファイルと src/tabs/browser.rs。

export global BrowserState {
    in-out property <string> url;
    // 0 起動していない、1 起動中、2 表示中、3 失敗
    in property <int> phase: 0;
    in property <string> error;
    callback open();
    callback close();
}

export component BrowserTab inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: Theme.hover;
                ti := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: Theme.fg;
                    selection-foreground-color: Theme.fg;
                    selection-background-color: #4d8ff566;
                    single-line: true;
                    text <=> BrowserState.url;
                    accepted => { BrowserState.open(); }
                }
                TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
            }
            Button { label: "開く"; primary: true; clicked => { BrowserState.open(); } }
            if BrowserState.phase == 2: Button { label: "閉じる"; clicked => { BrowserState.close(); } }
        }
        if BrowserState.phase == 1: HorizontalLayout {
            alignment: start;
            Spinner { indeterminate: true; width: 24px; height: 24px; }
        }
        if BrowserState.phase == 3: Text {
            text: BrowserState.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
