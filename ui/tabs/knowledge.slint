import { Theme } from "../theme.slint";
import { Button, AreaEdit } from "g_widgets.slint";
import { LogRow, LogList } from "log_rows.slint";
import { KbState, KbStrip, KbBody } from "kb.slint";

// 知識タブ。概要・禁止事項・失敗の記録・共通知識は kb.slint(src/tabs/kb.rs)。
// ここは「発動の記録」(ガードが止めた記録)と「引き継ぎ」(引き継ぎパックのプレビュー)。
// Rust 側から触る状態とコールバックは KnowledgeState にまとめる(src/tabs/knowledge.rs)。

export global KnowledgeState {
    in property <string> note;
    in property <[LogRow]> guard;
    in-out property <string> handoff-task;
    in property <string> handoff-text;
    callback part-changed(int);
    callback guard-toggled(int);
    callback guard-open-rule(int);
    callback guard-false-positive(int);
    callback handoff-preview();
}

component GuardView inherits Rectangle {
    Flickable {
        content-height: gc.preferred-height + 24px;
        gc := VerticalLayout {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            spacing: 8px;
            alignment: start;
            if KnowledgeState.note != "": Text {
                text: KnowledgeState.note;
                color: Theme.fg-tertiary;
                font-size: 12px;
                wrap: word-wrap;
            }
            LogList {
                rows: KnowledgeState.guard;
                toggled(i) => { KnowledgeState.guard-toggled(i); }
                action(i) => { KnowledgeState.guard-open-rule(i); }
                action2(i) => { KnowledgeState.guard-false-positive(i); }
            }
        }
    }
}

component HandoffView inherits Rectangle {
    Flickable {
        content-height: hc.preferred-height + 40px;
        hc := VerticalLayout {
            x: 24px;
            y: 20px;
            width: min(720px, parent.width - 48px);
            spacing: 8px;
            alignment: start;
            Text { text: "タスク"; color: Theme.fg-tertiary; font-size: 11px; }
            AreaEdit { text <=> KnowledgeState.handoff-task; lines-height: 90px; }
            HorizontalLayout {
                alignment: end;
                Button { label: "プレビュー"; primary: true; clicked => { KnowledgeState.handoff-preview(); } }
            }
            Text {
                text: KnowledgeState.handoff-text;
                color: Theme.fg;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

// 知識タブ: 概要 / 禁止事項 / 失敗の記録 / 共通知識 / 発動の記録 / 引き継ぎ
export component KnowledgeTab inherits Rectangle {
    background: Theme.surface;
    VerticalLayout {
        KbStrip {
            items: KbState.know-subs;
            current: KbState.know-sub;
            picked(i) => {
                KbState.know-sub = i;
                KnowledgeState.part-changed(i);
                KbState.sub-changed(i);
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if KbState.know-sub < 4: KbBody { }
            if KbState.know-sub == 4: GuardView { }
            if KbState.know-sub == 5: HandoffView { }
        }
    }
}
