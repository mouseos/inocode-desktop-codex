import { Theme } from "../theme.slint";
import { Icon, Glyph } from "../icons.slint";
import { IconButton } from "../widgets.slint";

export struct TermRun {
    text: string,
    fg: color,
    bg: color,
    has-fg: bool,
    has-bg: bool,
    inverse: bool,
    bold: bool,
}

export struct TermLine {
    runs: [TermRun],
    selected: bool,
}

export struct TermTab {
    title: string,
    selected: bool,
    exited: bool,
}

// Rust: src/side_panel/terminal.rs
export global TerminalState {
    in property <[TermLine]> lines;
    in property <[TermTab]> tabs;
    callback new-terminal();
    callback select(int);
    callback close(int);
    callback key(string, bool, bool, bool);
    // Text the user typed or an input method committed; and whether a key's text is such text.
    callback type-text(string);
    pure callback is-text(string) -> bool;
    callback viewport(length, length);
    // Lines to scroll back (positive) or forward; rows selected with the mouse; copy and paste.
    callback scroll(int);
    callback sel-start(int);
    callback sel-update(int);
    callback copy();
    callback paste();
}

export component TerminalView inherits Rectangle {
    background: Theme.surface;
    VerticalLayout {
        HorizontalLayout {
            height: 30px;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 3px;
            padding-bottom: 3px;
            spacing: 2px;
            for tab[i] in TerminalState.tabs: Rectangle {
                width: tl.preferred-width + 44px;
                border-radius: Theme.radius-row;
                background: tab.selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TerminalState.select(i); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 2px;
                    tl := Text {
                        text: tab.title;
                        color: tab.exited ? Theme.fg-tertiary : tab.selected ? Theme.fg : Theme.fg-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    IconButton {
                        glyph: Glyph.close;
                        icon-size: 12px;
                        box-size: 22px;
                        y: 0px;
                        clicked => { TerminalState.close(i); }
                    }
                }
            }
            IconButton {
                glyph: Glyph.add;
                icon-size: 16px;
                clicked => { TerminalState.new-terminal(); }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                glyph: Glyph.copy;
                icon-size: 15px;
                clicked => { TerminalState.copy(); }
            }
        }
        body := Rectangle {
            vertical-stretch: 1;
            clip: true;
            changed width => { TerminalState.viewport(self.width, self.height); }
            changed height => { TerminalState.viewport(self.width, self.height); }
            init => { TerminalState.viewport(self.width, self.height); ti.focus(); }
            input := FocusScope {
                // Keys that are not text (Enter, arrows, Tab, Ctrl/Alt combinations) go to the terminal here.
                // Text goes on to the small text field below, so an input method (Japanese) can compose
                // into it; what it commits is sent on from its edited callback.
                capture-key-pressed(e) => {
                    if (!TerminalState.is-text(e.text) || (e.modifiers.control && !e.modifiers.alt) || (e.modifiers.alt && !e.modifiers.control)) {
                        TerminalState.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift);
                        return accept;
                    }
                    return reject;
                }
                ti := TextInput {
                    x: 8px;
                    y: 6px;
                    width: 2px;
                    height: 17px;
                    single-line: true;
                    color: transparent;
                    edited => {
                        TerminalState.type-text(self.text);
                        self.text = "";
                    }
                }
                TouchArea {
                    mouse-cursor: MouseCursor.text;
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            ti.focus();
                            TerminalState.sel-start(Math.floor((self.mouse-y - 6px) / 17px));
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            TerminalState.sel-update(Math.floor((self.mouse-y - 6px) / 17px));
                        }
                    }
                    scroll-event(e) => {
                        TerminalState.scroll(e.delta-y > 0px ? 3 : -3);
                        accept
                    }
                }
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    alignment: start;
                    for line in TerminalState.lines: Rectangle {
                        height: 17px;
                        background: line.selected ? Theme.selected : transparent;
                        HorizontalLayout {
                            alignment: start;
                            for r in line.runs: Rectangle {
                                width: t.preferred-width;
                                background: r.inverse ? (r.has-fg ? r.fg : Theme.fg) : (r.has-bg ? r.bg : transparent);
                                t := Text {
                                    text: r.text;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    font-weight: r.bold ? 700 : 400;
                                    color: r.inverse ? (r.has-bg ? r.bg : Theme.surface) : (r.has-fg ? r.fg : Theme.fg);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
